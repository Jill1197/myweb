<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>จัดการวิดีโอ</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VLMJVZ7NQF"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-VLMJVZ7NQF');
  </script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans min-h-screen p-6">

  <div class="max-w-6xl mx-auto space-y-10">
    <!-- Upload Form -->
    <div class="bg-gray-800 p-6 rounded-lg shadow-lg">
      <h1 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-3">⬆ Upload Video</h1>
      <h4 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-3"><a href="/manage">manage</a></h4>
      <form action="/admin/videos/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
        <div>
          <label class="block mb-1 font-semibold">เลือกไฟล์วิดีโอ</label>
          <input type="file" name="video" accept="video/*" required
            class="w-full px-3 py-2 rounded bg-gray-700 text-white" />
        </div>

        <div>
          <label class="block mb-1 font-semibold">ตั้งชื่อไฟล์เอง (optional)</label>
          <input type="text" name="filename" placeholder="custom-name"
            class="w-full px-3 py-2 rounded bg-gray-700 text-white" />
        </div>

        <div>
          <label class="block mb-1 font-semibold">Comment</label>
          <input type="text" name="comment" placeholder="คำอธิบาย"
            class="w-full px-3 py-2 rounded bg-gray-700 text-white" />
        </div>

        <div>
          <label class="block mb-1 font-semibold">Active</label>
          <select name="active" class="w-full px-3 py-2 rounded bg-gray-700 text-white">
            <option value="1">Yes</option>
            <option value="0">No</option>
          </select>
        </div>

        <button type="submit"
          class="px-4 py-2 bg-cyan-600 rounded hover:bg-cyan-500 transition font-semibold text-white">
          Upload
        </button>
      </form>
    </div>

    <!-- Video List -->
    <div class="bg-gray-800 p-6 rounded-lg shadow-lg">
      <h2 class="text-xl font-bold text-white mb-4 border-l-4 border-cyan-400 pl-3">📂 วิดีโอทั้งหมด</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left border-collapse">
          <thead class="bg-gray-700 text-gray-300 uppercase">
            <tr>
              <th class="px-4 py-2">ID</th>
              <th class="px-4 py-2">File</th>
              <th class="px-4 py-2">Preview</th>
              <th class="px-4 py-2">Comment</th>
              <th class="px-4 py-2">Active</th>
              <th class="px-4 py-2">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% videos.forEach(video=> { %>
              <tr class="border-b border-gray-700 hover:bg-gray-700/50">
                <td class="px-4 py-2">
                  <%= video.id %>
                </td>
                <td class="px-4 py-2">
                  <%= video.files_name %>
                </td>
                <td class="px-4 py-2">
                  <video width="160" class="rounded" controls>
                    <source src="/videos/<%= video.files_name %>" type="video/mp4">
                  </video>
                </td>
                <td class="px-4 py-2">
                  <%= video.comment %>
                </td>
                <td class="px-4 py-2">
                  <% if (video.active) { %>
                    <span class="px-2 py-1 bg-green-600 text-white text-xs rounded">Active</span>
                    <% } else { %>
                      <span class="px-2 py-1 bg-red-600 text-white text-xs rounded">Inactive</span>
                      <% } %>
                </td>
                <td class="px-4 py-2 space-y-2">
                  <!-- Edit -->
                  <form action="/admin/videos/edit/<%= video.id %>" method="POST" class="space-y-2">
                    <input type="text" name="filename" value="<%= video.files_name %>"
                      class="w-full px-2 py-1 rounded bg-gray-700 text-white text-xs" />
                    <input type="text" name="comment" value="<%= video.comment %>"
                      class="w-full px-2 py-1 rounded bg-gray-700 text-white text-xs" />
                    <select name="active" class="w-full px-2 py-1 rounded bg-gray-700 text-white text-xs">
                      <option value="1" <%=video.active ? 'selected' : '' %>>Yes</option>
                      <option value="0" <%=!video.active ? 'selected' : '' %>>No</option>
                    </select>
                    <button type="submit"
                      class="w-full px-3 py-1 bg-yellow-500 hover:bg-yellow-400 text-black rounded text-xs font-semibold">
                      Update
                    </button>
                  </form>

                  <!-- Delete -->
                  <form action="/admin/videos/delete/<%= video.id %>" method="POST"
                    onsubmit="return confirm('Delete this video?')">
                    <button type="submit"
                      class="w-full px-3 py-1 bg-red-600 hover:bg-red-500 text-white rounded text-xs font-semibold">
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</body>

</html>