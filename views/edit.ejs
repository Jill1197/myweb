<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Media</title>
  <link rel="icon" href="/favicon.png" type="image/png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VLMJVZ7NQF"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-VLMJVZ7NQF');
  </script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans min-h-screen flex flex-col items-center justify-center p-6">

  <div class="w-full max-w-lg bg-gray-800 p-8 rounded-lg shadow-lg">
    <h1 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-3">✏ Edit Media</h1>

    <form method="POST" action="/edit/<%= media.id %>" class="space-y-4">
      <div>
        <label class="block mb-1 font-semibold" for="topic">Topic</label>
        <input type="text" name="topic" id="topic" required value="<%= media.topic %>"
          class="w-full px-3 py-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500" />
      </div>

      <div>
        <label class="block mb-1 font-semibold" for="image_embed">Image Embed</label>
        <textarea name="image_embed" id="image_embed" rows="4"
          class="w-full px-3 py-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500"><%= media.image_embed %></textarea>
      </div>

      <div>
        <label class="block mb-1 font-semibold" for="video_embed">Video Embed</label>
        <textarea name="video_embed" id="video_embed" rows="4"
          class="w-full px-3 py-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500"><%= media.video_embed %></textarea>
      </div>

      <div>
        <label class="block mb-1 font-semibold" for="video_views">Video Views</label>
        <textarea name="video_views" id="video_views" rows="4"
          class="w-full px-3 py-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500"><%= media.views %></textarea>
      </div>

      <div>
        <label class="block mb-1 font-semibold" for="video_views">Video Views</label>
        <!-- แก้ไข name ตรงนี้ -->
        <input type="number" name="views" id="video_views" value="<%= media.views %>"
          class="w-full px-3 py-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500" />
      </div>

      <div class="flex justify-between items-center">
        <button type="submit"
          class="px-4 py-2 bg-yellow-500 rounded hover:bg-yellow-400 transition font-semibold">Save</button>
        <a href="/" class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-500 transition">Back</a>
      </div>

    </form>
  </div>

</body>

</html>