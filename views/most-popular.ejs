<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Most Popular Videos</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans">

    <%- include('components/header') %>

        <!-- Popunder -->
        <script src="https://temptedrecognise.com/40/9e/d5/409ed51524bea4d5a17516963dca33ef.js"></script>
        <!-- Popunder -->
        <main class="container mx-auto px-6 py-8">

            <%- include('components/advert', { numberOfAds: 10 }) %>
                <br>
                <h1 class="text-3xl font-bold text-white mb-6">Most Popular Videos</h1>

                <% if (!videos || videos.length===0) { %>
                    <p class="text-gray-400">ไม่มีวิดีโอยอดนิยม</p>
                    <% } else { %>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                            <% videos.forEach(video=> { %>
                                <div
                                    class="bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition">
                                    <a href="/watch?id=<%= video.id %>">
                                        <!-- ใช้ data-src + punycode.js -->
                                        <img data-src="<%= video.image_embed %>" alt="<%= video.topic %>"
                                            class="w-full h-48 object-cover" />
                                    </a>
                                    <div class="p-4">
                                        <h2 class="text-white font-bold mb-2 text-lg truncate">
                                            <%= video.topic %>
                                        </h2>
                                        <p class="text-gray-400 text-sm">Views: <%= video.views || 0 %>
                                        </p>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <% } %>
        </main>

        <!-- punycode client-side -->
        <script src="https://cdn.jsdelivr.net/npm/punycode@2.1.1/punycode.min.js"></script>
        <script>
            // แปลง punycode สำหรับรูปภาพ
            document.querySelectorAll('img[data-src]').forEach(img => {
                try {
                    const url = new URL(img.dataset.src);
                    url.hostname = punycode.toUnicode(url.hostname);
                    img.src = url.toString();
                } catch (e) {
                    img.src = img.dataset.src; // fallback ถ้าไม่ใช่ URL
                }
            });
        </script>

</body>

</html>