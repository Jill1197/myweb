<!DOCTYPE html>
<html lang="th">

<head>
  <title>ผลการค้นหา: <%= keyword %> - JAV789VK</title>
  <link rel="icon" href="/favicon.png" type="image/png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans">

  <%- include('components/header') %>
  <%- include('components/sidebar') %>

  <main class="container mx-auto px-6 py-8">
    <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-4">
      ผลการค้นหาสำหรับ: <span class="text-cyan-400">"<%= keyword %>"</span>
    </h2>

    <% if (!videos || videos.length === 0) { %>
      <div class="text-center py-20 text-gray-500">
        <p>ไม่พบวิดีโอที่ตรงกับคำค้นหา "<%= keyword %>"</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
        <% videos.forEach(video => { %>
          <div class="media-item group">
            <a href="/watch?id=<%= video.id %>" class="block relative aspect-video overflow-hidden rounded-lg bg-gray-800 shadow-md">
              <img src="<%= video.image_embed || '/images/placeholder.png' %>" 
                   alt="<%= video.topic %>" 
                   class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition duration-300" 
                   loading="lazy" 
                   onerror="this.onerror=null; this.src='/images/placeholder.png';" />
            </a>
            
            <div class="content mt-3">
              <h3 class="text-white text-sm font-semibold line-clamp-2 min-h-[40px]">
                <%= video.topic %>
              </h3>
              <p class="text-gray-500 text-xs mt-1">
                Views: <%= Number(video.views || 0).toLocaleString() %>
              </p>
            </div>
          </div>
        <% }) %>
      </div>

      <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <div class="flex justify-center items-center space-x-1 mt-12 text-sm">
          <% const start = Math.max(1, currentPage - 1); %>
          <% const end = Math.min(totalPages, currentPage + 1); %>

          <% if (currentPage > 1) { %>
            <a href="/search?q=<%= encodeURIComponent(keyword) %>&page=1" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500 transition">««</a>
            <a href="/search?q=<%= encodeURIComponent(keyword) %>&page=<%= currentPage - 1 %>" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500 transition">«</a>
          <% } %>

          <% for (let i = start; i <= end; i++) { %>
            <a href="/search?q=<%= encodeURIComponent(keyword) %>&page=<%= i %>" 
               class="px-3 py-1 rounded <%= i === currentPage ? 'bg-cyan-500 text-white' : 'bg-gray-800 hover:bg-cyan-400 transition' %>">
              <%= i %>
            </a>
          <% } %>

          <% if (currentPage < totalPages) { %>
            <a href="/search?q=<%= encodeURIComponent(keyword) %>&page=<%= currentPage + 1 %>" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500 transition">»</a>
            <a href="/search?q=<%= encodeURIComponent(keyword) %>&page=<%= totalPages %>" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500 transition">»»</a>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </main>

</body>
</html>