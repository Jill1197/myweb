<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results: <%= keyword %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VLMJVZ7NQF"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-VLMJVZ7NQF');
    </script>
</head>


<body class="bg-gray-900 text-gray-300 font-sans">

    <%- include('components/header') %>

        <main class="container mx-auto px-6 py-8">
            <h1 class="text-3xl font-bold text-white mb-6">
                ผลการค้นหา: "<%= keyword %>"
            </h1>

            <% if (!videos || videos.length===0) { %>
                <p class="text-gray-400">ไม่พบผลลัพธ์</p>
                <% } else { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        <% videos.forEach(video=> { %>
                            <div
                                class="bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-transform duration-200 ease-in-out hover:scale-105">
                                <a href="/watch?id=<%= video.id %>" title="<%= video.topic %>">
                                    <div class="aspect-w-16 aspect-h-9">
                                        <img src="<%= video.image_embed %>" alt="<%= video.topic %>"
                                            class="w-full h-full object-cover" loading="lazy"
                                            onerror="this.src='/images/placeholder.png'">
                                    </div>
                                </a>
                                <div class="p-4">
                                    <h2 class="text-white font-bold mb-2 text-lg truncate">
                                        <%= video.topic %>
                                    </h2>
                                    <p class="text-gray-400 text-sm">Views: <%= video.views || 0 %>
                                    </p>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>
        </main>

        <!-- punycode client-side -->
        <script src="https://cdn.jsdelivr.net/npm/punycode@2.1.1/punycode.min.js"></script>
        <script>
            // แปลง punycode สำหรับรูปภาพ
            document.querySelectorAll('img[data-src]').forEach(img => {
                try {
                    const url = new URL(img.dataset.src);
                    url.hostname = punycode.toUnicode(url.hostname);
                    img.src = url.toString();
                } catch (e) {
                    img.src = img.dataset.src; // fallback ถ้าไม่ใช่ URL
                }
            });
        </script>

</body>

</html>