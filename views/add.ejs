<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Media</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans min-h-screen flex flex-col items-center justify-center p-6">
    <div class="w-full max-w-lg bg-gray-800 p-8 rounded-lg shadow-lg">
        <h1 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-3">➕ Add Media</h1>
        <h4 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-3"><a href="/manage">manage</a></h4>

        <form method="POST" action="/add" class="space-y-4">
            <div>
                <label class="block mb-1 font-semibold" for="topic">Topic</label>
                <input type="text" name="topic" id="topic" required
                    class="w-full px-3 py-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500" />
            </div>

            <div>
                <label class="block mb-1 font-semibold" for="image_embed">Image Embed</label>
                <textarea name="image_embed" id="image_embed" rows="4"
                    class="w-full px-3 py-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500"></textarea>
            </div>

            <div>
                <label class="block mb-1 font-semibold" for="video_embed">Video Embed</label>
                <textarea name="video_embed" id="video_embed" rows="4"
                    class="w-full px-3 py-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500"></textarea>
            </div>

            <div class="relative w-full">
                <!-- Input -->
                <input type="text" id="tagInput" placeholder="พิมพ์ tag แล้ว Enter หรือเลือกจากรายการ"
                    class="w-full px-4 py-2 rounded-t-lg bg-gray-700 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 transition" />

                <!-- Suggestions Dropdown -->
                <ul id="suggestions"
                    class="absolute left-0 right-0 bg-gray-800 text-white rounded-b-lg shadow-lg max-h-48 overflow-y-auto z-20 hidden border border-gray-600 animate-slideDown">
                </ul>

                <!-- Selected Tags -->
                <div id="tagsContainer" class="flex flex-wrap mt-2 gap-2"></div>

                <!-- Hidden Input สำหรับส่งไป backend -->
                <input type="hidden" name="tag" id="hiddenTags">
            </div>

            <!-- Tailwind Animation (Slide Down) -->
            <style>
                @keyframes slideDown {
                    0% {
                        opacity: 0;
                        transform: translateY(-5px);
                    }

                    100% {
                        opacity: 1;
                        transform: translateY(0);
                    }
                }

                .animate-slideDown {
                    animation: slideDown 0.15s ease-out forwards;
                }
            </style>


            <div class="flex justify-between items-center">
                <button type="submit"
                    class="px-4 py-2 bg-cyan-600 rounded hover:bg-cyan-500 transition font-semibold">Add</button>
                <a href="/" class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-500 transition">Back</a>
            </div>
        </form>
    </div>

    <script>
        const tagInput = document.getElementById('tagInput');
        const suggestionsEl = document.getElementById('suggestions');
        const tagsContainer = document.getElementById('tagsContainer');
        let tags = [];
        let availableTags = [];

        // ดึง tag จาก API
        async function loadTags() {
            try {
                const res = await fetch('/api/v1/tags');
                if (!res.ok) throw new Error('Failed to fetch tags');
                const data = await res.json();

                // รองรับทั้ง object และ string
                if (data.length > 0 && typeof data[0] === 'object' && data[0].name) {
                    availableTags = data.map(t => t.name);
                } else {
                    availableTags = data;
                }

                console.log("✅ Tags loaded:", availableTags);
            } catch (err) {
                console.error("❌ loadTags error:", err);
            }
        }


        loadTags(); // โหลดตอนเริ่ม

        function renderTags() {
            tagsContainer.innerHTML = '';
            tags.forEach(tag => {
                const tagElem = document.createElement('span');
                tagElem.textContent = tag;
                tagElem.className = 'inline-block bg-cyan-600 text-white px-2 py-1 rounded-full mr-2 mb-2 flex items-center gap-1';

                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.textContent = '×';
                removeBtn.className = 'ml-1';
                removeBtn.onclick = () => removeTag(tag);

                tagElem.appendChild(removeBtn);
                tagsContainer.appendChild(tagElem);
            });

            // ✅ อัปเดต hidden input
            document.getElementById('hiddenTags').value = tags.join(',');
        }

        function removeTag(tag) {
            tags = tags.filter(t => t !== tag);
            renderTags();
        }

        function showSuggestions(value = '') {
            suggestionsEl.innerHTML = '';
            const filtered = availableTags.filter(t => !tags.includes(t) && t.toLowerCase().includes(value.toLowerCase()));
            if (filtered.length > 0) {
                filtered.forEach(tag => {
                    const li = document.createElement('li');
                    li.textContent = tag;
                    li.className = 'px-3 py-1 hover:bg-cyan-500 cursor-pointer';
                    li.onclick = () => {
                        addTag(tag);
                        suggestionsEl.classList.add('hidden');
                    }
                    suggestionsEl.appendChild(li);
                });
                suggestionsEl.classList.remove('hidden');
            } else {
                suggestionsEl.classList.add('hidden');
            }
        }

        function addTag(tag) {
            if (!tags.includes(tag)) {
                tags.push(tag);
                // ไม่ต้องเพิ่มใน availableTags เพราะ API จะอัปเดตเอง
                renderTags();
                tagInput.value = '';
            }
        }

        tagInput.addEventListener('input', () => showSuggestions(tagInput.value));
        tagInput.addEventListener('focus', () => showSuggestions(tagInput.value));
        tagInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                const value = tagInput.value.trim();
                if (value) addTag(value);
                suggestionsEl.classList.add('hidden');
            }
        });

        document.addEventListener('click', (e) => {
            if (e.target !== tagInput) suggestionsEl.classList.add('hidden');
        });
    </script>

</body>

</html>