<!DOCTYPE html>
<html lang="th">

<head>
  <title>ดู <%= media.topic %> ออนไลน์ดูฟรี | JAV789VK</title>
  <meta name="description" content="รับชมวิดีโอ <%= media.topic %> หมวดหมู่ <%= media.tag || '' %> ดูออนไลน์ฟรี" />
  
  <link rel="canonical" href="https://www.jav789vk.com/watch?id=<%= media.id %>" />
  
  <meta name="robots" content="index, follow" />
</head>

<body class="bg-gray-900 text-gray-300 font-sans">

  <%- include('components/header') %>
  <main class="container mx-auto px-6 py-8">
    <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-4">
      คลิปสำหรับ Tag: <span class="text-cyan-400"><%= tag %></span>
    </h2>

    <div class="flex flex-col lg:flex-row gap-8">
      <div class="w-full lg:w-3/4">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          <% mediaList.forEach(media => { %>
            <div class="media-item group">
              <a href="/watch?id=<%= media.id %>" class="block relative aspect-video overflow-hidden rounded-lg bg-gray-800 shadow-md">
                <img src="<%= media.image_embed || '/images/placeholder.png' %>" 
                     alt="<%= media.topic %>" 
                     class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition duration-300" 
                     loading="lazy" 
                     onerror="this.onerror=null; this.src='/images/placeholder.png';" />
              </a>
              
              <div class="content mt-3">
                <h3 class="text-white text-sm font-semibold line-clamp-2 min-h-[40px]">
                  <%= media.topic %>
                </h3>
                
                <div class="mt-2 flex flex-wrap gap-1">
                  <% if (media.tag) { %>
                    <% media.tag.split(',').slice(0, 2).forEach(function(t) { %>
                      <span class="text-[10px] text-cyan-400 border border-cyan-400/30 px-1.5 py-0.5 rounded">
                        <%= t.trim() %>
                      </span>
                    <% }) %>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <div class="flex justify-center items-center space-x-1 mt-12 text-sm">
            <% if (currentPage > 1) { %>
              <a href="/tag/<%= encodeURIComponent(tag) %>?page=1" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500 transition">««</a>
              <a href="/tag/<%= encodeURIComponent(tag) %>?page=<%= currentPage - 1 %>" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500 transition">«</a>
            <% } %>

            <%
              const start = Math.max(1, currentPage - 1);
              const end = Math.min(totalPages, currentPage + 1);
            %>

            <% if (start > 1) { %>
              <a href="/tag/<%= encodeURIComponent(tag) %>?page=1" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500 transition">1</a>
              <% if (start > 2) { %><span class="px-2 text-gray-500">...</span><% } %>
            <% } %>

            <% for (let i = start; i <= end; i++) { %>
              <a href="/tag/<%= encodeURIComponent(tag) %>?page=<%= i %>" 
                 class="px-3 py-1 rounded <%= i === currentPage ? 'bg-cyan-500 text-white' : 'bg-gray-800 hover:bg-cyan-400 transition' %>">
                <%= i %>
              </a>
            <% } %>

            <% if (end < totalPages) { %>
              <% if (end < totalPages - 1) { %><span class="px-2 text-gray-500">...</span><% } %>
              <a href="/tag/<%= encodeURIComponent(tag) %>?page=<%= totalPages %>" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500 transition"><%= totalPages %></a>
            <% } %>

            <% if (currentPage < totalPages) { %>
              <a href="/tag/<%= encodeURIComponent(tag) %>?page=<%= currentPage + 1 %>" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500 transition">»</a>
              <a href="/tag/<%= encodeURIComponent(tag) %>?page=<%= totalPages %>" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500 transition">»»</a>
            <% } %>
          </div>
        <% } %>
      </div>

      <aside class="w-full lg:w-1/4">
        <div class="bg-gray-800 p-4 rounded-lg shadow-lg">
          <h3 class="text-xl font-bold text-white mb-4 border-l-4 border-cyan-400 pl-3">ประเภททั้งหมด</h3>
          <ul class="space-y-2 max-h-[600px] overflow-y-auto pr-2">
            <% allTags.forEach(t => { %>
              <li>
                <a href="/tag/<%= encodeURIComponent(t.name) %>" 
                   class="block py-1 border-b border-gray-700 hover:text-cyan-400 transition">
                  <%= t.name %>
                </a>
              </li>
            <% }) %>
          </ul>
        </div>
      </aside>
    </div>
  </main>
</body>
</html>