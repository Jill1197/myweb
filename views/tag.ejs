<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tag: <%= tag %>
  </title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VLMJVZ7NQF"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-VLMJVZ7NQF');
  </script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans min-h-screen">

  <!-- header -->
  <%- include('components/header') %>

    <main class="container mx-auto px-6 py-8">
      <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-4">
        คลิปสำหรับ Tag: <span class="text-cyan-400">
          <%= tag %>
        </span>
      </h2>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Media Grid -->
        <div class="w-full lg:w-3/4">
          <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-4 gap-6">
            <% mediaList.forEach(media=> { %>
              <div class="media-item bg-gray-800 p-2 rounded-lg hover:shadow-lg transition">
                <a href="/watch?id=<%= media.id %>">
                  <img src="<%= media.image_embed %>" alt="media" class="w-full h-auto rounded-lg">
                </a>
                <div class="mt-2">
                  <h3 class="text-white text-sm font-semibold">
                    <%= media.topic %>
                  </h3>

                  <!-- Tags -->
                  <div class="mt-1 flex flex-wrap gap-2">
                    <% if (media.tag) { %>
                      <% media.tag.split(',').forEach(function(t) { %>
                        <a href="/tag/<%= encodeURIComponent(t) %>"
                          class="px-2 py-1 bg-cyan-600 rounded text-white text-xs hover:bg-cyan-500 transition">
                          <%= t %>
                        </a>
                        <% }) %>
                          <% } %>
                  </div>
                </div>
              </div>
              <% }) %>
          </div>
        </div>

        <!-- sidebar -->
        <aside class="w-full lg:w-1/4 space-y-8">
          <div class="bg-gray-800 p-4 rounded-lg shadow-lg">
            <h3 class="text-xl font-bold text-white mb-4 border-l-4 border-cyan-400 pl-3">
              ประเภททั้งหมด
            </h3>
            <ul class="space-y-2">
              <% allTags.forEach(t=> { %>
                <li>
                  <a href="/tag/<%= encodeURIComponent(t.name) %>" class="hover:text-cyan-400">
                    <%= t.name %>
                  </a>
                </li>
                <% }) %>
            </ul>
          </div>

          <div
            class="flex items-center justify-center bg-gray-700 border-2 border-dashed border-gray-500 rounded-lg w-full h-64">
            <span class="text-gray-400 text-lg font-bold">โฆษณา</span>
          </div>
        </aside>
      </div>
    </main>
</body>

</html>