<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Media Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VLMJVZ7NQF"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-VLMJVZ7NQF');
  </script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans min-h-screen">
  <!-- header -->
  <header class="bg-gray-800 shadow-lg sticky top-0 z-10">
    <div
      class="container mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 md:gap-0">
      <h1 class="text-2xl font-bold text-white tracking-wider">
        Media <span class="text-cyan-400">Manager</span>
      </h1>

      <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4 w-full md:w-auto">
        <% if (user) { %>
          <p class=" font-semibold">Welcome : <span class="text-green-500">
              <%= user.username %>
            </span></p>

          <div class="flex flex-wrap gap-2">
            <a href="/logout" class="px-3 py-1 bg-red-600 rounded hover:bg-red-500 transition">Logout</a>
            <a href="/add" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">➕ Add Media</a>
            <a href="/tags" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">Tag Manager</a>
            <a href="/admin/ads" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">Ads Manager</a>
            <a href="/admin/videos" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">Videos Ads
              Manager</a>
            <% if (user.username==='admin' ) { %>
              <a href="/export-sqlite" class="px-3 py-1 bg-green-600 rounded hover:bg-green-500 transition">💾 Export
                SQLite3</a>
              <% } %>
          </div>
          <% } else { %>
            <div class="flex flex-wrap gap-2">
              <a href="/admin/login" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">Login</a>
              <a href="/tags" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">Tag Manager</a>
            </div>
            <% } %>
      </div>
    </div>
  </header>

  <main class="container mx-auto px-6 py-8">
    <h2 class="text-2xl font-bold mb-6 border-l-4 border-cyan-400 pl-4">
      รายการสื่อ
    </h2>

    <div class="overflow-x-auto">
      <table class="min-w-full bg-gray-800 rounded-lg shadow-lg overflow-hidden">
        <thead class="bg-gray-700 text-gray-200">
          <tr>
            <th class="px-4 py-3 text-left text-sm md:text-base">ID</th>
            <th class="px-4 py-3 text-left text-sm md:text-base">Topic</th>
            <th class="px-4 py-3 text-left text-sm md:text-base">Tag</th>
            <th class="px-4 py-3 text-left text-sm md:text-base">Image</th>
            <th class="px-4 py-3 text-left text-sm md:text-base">Video</th>
            <% if (user && user.username==='admin' ) { %>
              <th class="px-4 py-3 text-left text-sm md:text-base">Actions</th>
              <% } %>
          </tr>
        </thead>
        <tbody class="text-gray-300">
          <% mediaList.forEach(m=> { %>
            <tr class="border-b border-gray-700 hover:bg-gray-700 transition">
              <!-- ID -->
              <td class="px-4 py-3 text-center align-middle">
                <%= m.id %>
              </td>

              <!-- Topic -->
              <td class="px-4 py-3 text-left align-middle">
                <%= m.topic %>
              </td>

              <!-- Tag -->
              <td class="px-4 py-3 text-left align-middle">
                <%= m.tag %>
              </td>

              <!-- Image -->
              <td class="px-4 py-3 text-center align-middle">
                <img src="<%= m.image_embed %>" alt="media" class="w-24 md:w-32 rounded-lg shadow-md mx-auto" />
              </td>

              <!-- Watch -->
              <td class="px-4 py-3 text-center align-middle">
                <a href="/watch?id=<%= m.id %>"
                  class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition text-sm md:text-base inline-block">
                  ▶ Watch
                </a>
              </td>

              <% if (user && user.username==='admin' ) { %>
                <!-- Actions -->
                <td class="px-4 py-3 text-center align-middle">
                  <div class="flex justify-center items-center gap-2">
                    <a href="/edit/<%= m.id %>"
                      class="px-3 py-1 bg-yellow-500 rounded hover:bg-yellow-400 transition text-sm md:text-base">
                      ✏ Edit
                    </a>
                    <a href="/delete/<%= m.id %>" onclick="return confirm('Confirm delete?')"
                      class="px-3 py-1 bg-red-600 rounded hover:bg-red-500 transition text-sm md:text-base">
                      🗑 Delete
                    </a>
                  </div>
                </td>
                <% } %>
            </tr>
            <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>

</html>