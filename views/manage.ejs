<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8" />
  <link rel="icon" href="/favicon.png" type="image/png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Media Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans min-h-screen">
  <!-- header -->
  <header class="bg-gray-800 shadow-lg sticky top-0 z-10">
    <div class="container mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 md:gap-0">
      <h1 class="text-2xl font-bold text-white tracking-wider">
        Media <span class="text-cyan-400">Manager</span>
      </h1>

      <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4 w-full md:w-auto">
        <% if (user) { %>
          <p class=" font-semibold">Welcome : <span class="text-green-500">
              <%= user.username %>
            </span></p>

          <div class="flex flex-wrap gap-2">
            <a href="/logout" class="px-3 py-1 bg-red-600 rounded hover:bg-red-500 transition">Logout</a>
            <a href="/add" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">➕ Add Media</a>
            <a href="/tags" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">Tag Manager</a>
            <a href="/admin/ads" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">Ads Manager</a>
            <a href="/admin/videos" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">Videos Ads Manager</a>
            <a href="/short-link" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">Short Link</a>
            <% if (user.username==='admin' ) { %>
              <a href="/export-sqlite" class="px-3 py-1 bg-green-600 rounded hover:bg-green-500 transition">💾 Export SQLite3</a>
            <% } %>
          </div>
        <% } else { %>
          <div class="flex flex-wrap gap-2">
            <a href="/admin/login" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">Login</a>
            <a href="/tags" class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition">Tag Manager</a>
          </div>
        <% } %>
      </div>
    </div>
  </header>

  <main class="container mx-auto px-6 py-8">
    <h2 class="text-2xl font-bold mb-6 border-l-4 border-cyan-400 pl-4">
      รายการสื่อ
    </h2>

    <div class="overflow-x-auto">
      <table class="min-w-full bg-gray-800 rounded-lg shadow-lg overflow-hidden">
        <thead class="bg-gray-700 text-gray-200">
          <tr>
            <th class="px-4 py-3 text-left text-sm md:text-base">ID</th>
            <th class="px-4 py-3 text-left text-sm md:text-base">Topic</th>
            <th class="px-4 py-3 text-left text-sm md:text-base">Tag</th>
            <th class="px-4 py-3 text-left text-sm md:text-base">Image</th>
            <th class="px-4 py-3 text-left text-sm md:text-base">Video</th>
            <% if (user && user.username==='admin' ) { %>
              <th class="px-4 py-3 text-left text-sm md:text-base">Actions</th>
            <% } %>
          </tr>
        </thead>
        <!-- เพิ่ม ID ให้ tbody เพื่อให้ JS จัดการได้ง่าย -->
        <tbody id="media-table-body" class="text-gray-300">
          <% mediaList.forEach(m=> { %>
            <tr class="border-b border-gray-700 hover:bg-gray-700 transition">
              <td class="px-4 py-3 text-center align-middle">
                <%= m.id %>
              </td>
              <td class="px-4 py-3 text-left align-middle">
                <%= m.topic %>
              </td>
              <td class="px-4 py-3 text-left align-middle">
                <%= m.tag %>
              </td>
              <td class="px-4 py-3 text-center align-middle">
                <!-- ใส่ loading="lazy" เพื่อประหยัดการโหลดรูปจาก API ภายนอก -->
                <img
                  src="<%= m.image_embed %>"
                  alt="media"
                  class="w-24 md:w-32 h-auto rounded-lg shadow-md mx-auto"
                  loading="lazy"
                />
              </td>
              <td class="px-4 py-3 text-center align-middle">
                <a href="/watch?id=<%= m.id %>"
                  class="px-3 py-1 bg-cyan-600 rounded hover:bg-cyan-500 transition text-sm md:text-base inline-block">
                  ▶ Watch
                </a>
              </td>
              <% if (user && user.username==='admin' ) { %>
                <td class="px-4 py-3 text-center align-middle">
                  <div class="flex justify-center items-center gap-2">
                    <a href="/edit/<%= m.id %>"
                      class="px-3 py-1 bg-yellow-500 rounded hover:bg-yellow-400 transition text-sm md:text-base">
                      ✏ Edit
                    </a>
                    <a href="/delete/<%= m.id %>" onclick="return confirm('Confirm delete?')"
                      class="px-3 py-1 bg-red-600 rounded hover:bg-red-500 transition text-sm md:text-base">
                      🗑 Delete
                    </a>
                  </div>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- ส่วนควบคุม Pagination -->
    <div class="mt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p id="pagination-info" class="text-sm text-gray-400"></p>
      <div class="flex gap-2" id="pagination-buttons">
        <!-- ปุ่มกดเปลี่ยนหน้าจะถูกสร้างด้วย JS -->
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const rowsPerPage = 10; // จำนวนรายการที่ต้องการโชว์ต่อหน้า
      let currentPage = 1;

      const tbody = document.getElementById('media-table-body');
      const allRows = Array.from(tbody.getElementsByTagName('tr'));
      const totalPages = Math.ceil(allRows.length / rowsPerPage);

      function updateDisplay() {
        const start = (currentPage - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        // ซ่อน/แสดง แถว (รูปในแถวที่ซ่อนจะไม่ถูกโหลดถ้าใส่ loading="lazy")
        allRows.forEach((row, index) => {
          row.style.display = (index >= start && index < end) ? '' : 'none';
        });

        // อัปเดตข้อความ
        const info = document.getElementById('pagination-info');
        info.innerText = `Showing ${Math.min(start + 1, allRows.length)} to ${Math.min(end, allRows.length)} of ${allRows.length} items`;

        renderButtons();
      }

      function renderButtons() {
        const btnContainer = document.getElementById('pagination-buttons');
        btnContainer.innerHTML = '';

        // ปุ่มย้อนกลับ
        const prevBtn = createBtn('«', () => {
          if (currentPage > 1) { currentPage--; updateDisplay(); window.scrollTo(0, 0); }
        }, currentPage === 1);
        btnContainer.appendChild(prevBtn);

        // เลขหน้า (โชว์เฉพาะหน้าใกล้เคียงถ้าหน้าเยอะ)
        for (let i = 1; i <= totalPages; i++) {
          if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
            const numBtn = createBtn(i, () => {
              currentPage = i;
              updateDisplay();
              window.scrollTo(0, 0);
            }, false, i === currentPage);
            btnContainer.appendChild(numBtn);
          } else if (i === currentPage - 2 || i === currentPage + 2) {
            const span = document.createElement('span');
            span.innerText = '...';
            span.className = 'px-2 self-end';
            btnContainer.appendChild(span);
          }
        }

        // ปุ่มถัดไป
        const nextBtn = createBtn('»', () => {
          if (currentPage < totalPages) { currentPage++; updateDisplay(); window.scrollTo(0, 0); }
        }, currentPage === totalPages);
        btnContainer.appendChild(nextBtn);
      }

      function createBtn(text, onClick, disabled, isActive = false) {
        const btn = document.createElement('button');
        btn.innerText = text;
        btn.disabled = disabled;
        btn.className = `px-3 py-1 rounded transition ${
          isActive
            ? 'bg-cyan-500 text-white font-bold'
            : 'bg-gray-800 hover:bg-gray-700 text-gray-300'
        } ${disabled ? 'opacity-30 cursor-not-allowed' : ''}`;

        if (!disabled) btn.onclick = onClick;
        return btn;
      }

      // เริ่มทำงาน
      updateDisplay();
    });
  </script>
</body>

</html>