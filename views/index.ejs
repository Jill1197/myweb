<!DOCTYPE html>
<html>

<head>
  <title>อยากดูหนังโป๊ฟรีๆ ต้องเว็บนี้เท่านั้น jav789vk คลิปหลุดไทย นักศึกษาหลุด นักศึกษาหลุดVK VKไทยหลุด ดูหีไทย ดูหนังโป๊ไทยvk เว็บโป๊เร็วๆ nhentai การ์ตูนโป๊ภาพสวยๆ JAV789VK - ดูฟรี </title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="index,follow,max-snippet:180,max-image-preview:large" />
  <meta name="googlebot" content="max-snippet:180" />
  <link rel="canonical" href="https://www.jav789vk.com/" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VLMJVZ7NQF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VLMJVZ7NQF');
    </script>
  <meta name="description"
    content="อยากดูหนังโป๊ฟรีๆ ต้องเว็บนี้เท่านั้น jav789vk คลิปหลุดไทย นักศึกษาหลุด นักศึกษาหลุดVK VKไทยหลุด ดูหีไทย ดูหนังโป๊ไทยvk เว็บโป๊เร็วๆ nhentai การ์ตูนโป๊ภาพสวยๆ" />
</head>

<body>
  <div class="bg-gray-900 min-h-screen text-gray-300 font-sans">
    <!-- header -->
    <%- include('components/header') %>

      <%- include('components/sidebar') %>

        <main class="container mx-auto px-6 py-8">
          <%- include('components/advert', { numberOfAds: 10 }) %>

            <!-- Media List -->
            <div class="flex flex-col lg:flex-row gap-8 mt-5">
              <div class="w-full lg:w-3/4">
                <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-4">
                  หนังยอดนิยม 🔥
                </h2>

                <!-- Grid แสดง media -->
                <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-4 gap-6">
                  <% mediaList.forEach(media=> { %>
                    <div class="media-item">
                      <a href="/watch?id=<%= media.id %>">
                        <img src="<%= media.image_embed %>" alt="media" class="w-full h-auto rounded-lg" />
                      </a>
                      <div class="content mt-2">
                        <h3 class="text-white text-sm font-semibold">
                          <%= media.topic %>
                        </h3>
                      </div>
                    </div>
                    <% }) %>
                </div>

                <!-- Pagination -->
                <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                  <div class="flex justify-center items-center space-x-1 mt-6 overflow-x-auto max-w-full px-2 text-sm">

                    <!-- ปุ่มไปหน้าแรก -->
                    <% if (currentPage> 1) { %>
                      <a href="/?page=1" class="px-3 py-1 bg-gray-700 text-white rounded hover:bg-cyan-500">««</a>
                      <a href="/?page=<%= currentPage - 1 %>"
                        class="px-3 py-1 bg-gray-700 text-white rounded hover:bg-cyan-500">«</a>
                      <% } %>

                        <% const maxVisible=3; // จำนวนหน้าที่จะแสดงรอบๆ currentPage let start=Math.max(1, currentPage -
                          1); let end=Math.min(totalPages, currentPage + 1); if (start> 2) { %>
                          <a href="/?page=1" class="px-3 py-1 bg-gray-700 text-gray-200 rounded hover:bg-cyan-400">1</a>
                          <span class="px-2">...</span>
                          <% } %>

                            <% for (let i=start; i <=end; i++) { %>
                              <a href="/?page=<%= i %>" class="px-3 py-1 rounded 
                        <%= i === currentPage 
                              ? 'bg-cyan-500 text-white' 
                              : 'bg-gray-700 text-gray-200 hover:bg-cyan-400 hover:text-white' %>">
                                <%= i %>
                              </a>
                              <% } %>

                                <% if (end < totalPages - 1) { %>
                                  <span class="px-2">...</span>
                                  <a href="/?page=<%= totalPages %>"
                                    class="px-3 py-1 bg-gray-700 text-gray-200 rounded hover:bg-cyan-400">
                                    <%= totalPages %>
                                  </a>
                                  <% } else if (end===totalPages - 1) { %>
                                    <a href="/?page=<%= totalPages %>"
                                      class="px-3 py-1 bg-gray-700 text-gray-200 rounded hover:bg-cyan-400">
                                      <%= totalPages %>
                                    </a>
                                    <% } %>

                                      <!-- ปุ่มไปหน้าสุดท้าย -->
                                      <% if (currentPage < totalPages) { %>
                                        <a href="/?page=<%= currentPage + 1 %>"
                                          class="px-3 py-1 bg-gray-700 text-white rounded hover:bg-cyan-500">»</a>
                                        <a href="/?page=<%= totalPages %>"
                                          class="px-3 py-1 bg-gray-700 text-white rounded hover:bg-cyan-500">»»</a>
                                        <% } %>

                  </div>
                  <% } %>



              </div>

              <!-- sidebar (right) -->
              <aside class="w-full lg:w-1/4">
                <div class="bg-gray-800 p-4 rounded-lg shadow-lg">
                  <h3 class="text-xl font-bold text-white mb-4 border-l-4 border-cyan-400 pl-3">
                    ประเภท
                  </h3>
                  <!-- list มี scrollbar ถ้าเกิน 10 -->
                  <ul class="space-y-2 max-h-64 overflow-y-auto pr-2">
                    <% if (typeof tags !=='undefined' && tags.length> 0) { %>
                      <% tags.forEach(tagItem=> { %>
                        <li>
                          <a href="/tag/<%= encodeURIComponent(tagItem.name) %>" class="hover:text-cyan-400">
                            <%= tagItem.name %>
                          </a>
                        </li>
                        <% }) %>
                          <% } else { %>
                            <li><a href="#" class="hover:text-cyan-400">ไม่มีประเภท</a></li>
                            <% } %>
                  </ul>
                </div>
              </aside>
            </div>
        </main>
  </div>

  <!-- Script -->
  <script>
    function closeAd(adId) {
      const adElement = document.getElementById(adId);
      if (adElement) {
        adElement.style.display = 'none';
      }
    }
  </script>
</body>



</html>
