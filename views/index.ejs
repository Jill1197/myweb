<!DOCTYPE html>
<html lang="th">

<head>
  <title>JAV789VK - ดูหนังโป๊ฟรี คลิปหลุดไทย นักศึกษาหลุด VK ไทยหลุด</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="index,follow,max-snippet:180,max-image-preview:large" />
  <meta name="description" content="อยากดูหนังโป๊ฟรีๆ ต้องเว็บนี้เท่านั้น jav789vk คลิปหลุดไทย นักศึกษาหลุด VKไทยหลุด ดูหีไทย" />

  <link rel="canonical" href="https://www.jav789vk.com/" />
  <script src="https://cdn.tailwindcss.com"></script>

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VLMJVZ7NQF"></script>
  <script>
    window.dataLayer = window.dataLayer || [];

    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', 'G-VLMJVZ7NQF');
  </script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans">
  <div class="min-h-screen">
    <%- include('components/header') %>
    <%- include('components/sidebar') %>

    <main class="container mx-auto px-6 py-8">
      <%- include('components/advert', { numberOfAds: 10 }) %>

      <div class="flex flex-col lg:flex-row gap-8 mt-5">
        <div class="w-full lg:w-3/4">
          <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-4">
            หนังยอดนิยม 🔥
          </h2>

          <div id="top-views-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-12">
            <div class="col-span-full text-center py-10">
              <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-cyan-400 mb-2"></div>
              <p class="text-gray-400 text-sm">กำลังโหลดหนังยอดนิยม...</p>
            </div>
          </div>

          <!---fetch videos most popular 5 อันดับ api คือ /api/v1/top-views --->
          <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-4">
            หนังใหม่ 🔥
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% mediaList.forEach(media => { %>
            <div class="media-item group">

              <a href="/watch?id=<%= media.id %>" class="block relative aspect-video overflow-hidden rounded-lg bg-gray-800 shadow-md">

                <img src="<%= media.image_embed || '/images/placeholder.png' %>" alt="<%= media.topic %>" class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition duration-300" loading="lazy" onerror="this.onerror=null; this.src='/images/placeholder.png';" />
              </a>

              <div class="content mt-2">
                <h3 class="text-white text-sm font-semibold line-clamp-2 min-h-[40px]">
                  <%= media.topic %>
                </h3>
              </div>
            </div>
            <% }) %>
          </div>

          <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <div class="flex justify-center items-center space-x-1 mt-10 text-sm">
            <% if (currentPage > 1) { %>
            <a href="/?page=1" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500">««</a>
            <a href="/?page=<%= currentPage - 1 %>" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500">«</a>
            <% } %>

            <%
                const maxVisible = 3;
                let start = Math.max(1, currentPage - 1);
                let end = Math.min(totalPages, currentPage + 1);
              %>

            <% if (start > 1) { %>
            <a href="/?page=1" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500">1</a>
            <% if (start > 2) { %><span class="px-2">...</span><% } %>
            <% } %>

            <% for (let i = start; i <= end; i++) { %>
            <a href="/?page=<%= i %>" class="px-3 py-1 rounded <%= i === currentPage ? 'bg-cyan-500 text-white' : 'bg-gray-800 hover:bg-cyan-400' %>">
              <%= i %>
            </a>
            <% } %>

            <% if (end < totalPages) { %>
            <% if (end < totalPages - 1) { %><span class="px-2">...</span><% } %>
            <a href="/?page=<%= totalPages %>" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500"><%= totalPages %></a>
            <% } %>

            <% if (currentPage < totalPages) { %>
            <a href="/?page=<%= currentPage + 1 %>" class="px-3 py-1 bg-gray-800 rounded hover:bg-cyan-500">»</a>
            <% } %>
          </div>
          <% } %>
        </div>

        <aside class="w-full lg:w-1/4">
          <div class="bg-gray-800 p-4 rounded-lg shadow-lg">
            <h3 class="text-xl font-bold text-white mb-4 border-l-4 border-cyan-400 pl-3">ประเภท</h3>
            <ul class="space-y-2 max-h-96 overflow-y-auto pr-2">
              <% if (typeof tags !== 'undefined' && tags.length > 0) { %>
              <% tags.forEach(tagItem => { %>
              <li>
                <a href="/tag/<%= encodeURIComponent(tagItem.name) %>" class="hover:text-cyan-400 block py-1 border-b border-gray-700">
                  <%= tagItem.name %>
                </a>
              </li>
              <% }) %>
              <% } else { %>
              <li class="text-gray-500">ไม่มีประเภท</li>
              <% } %>
            </ul>
          </div>
        </aside>
      </div>
    </main>
  </div>

  <script>
    function closeAd(adId) {
      const el = document.getElementById(adId);
      if (el) el.style.display = 'none';
    }
  </script>

  <script>
    async function fetchTopViews() {
      try {
        const response = await fetch('/api/v1/top-views/5');
        const data = await response.json();
        const container = document.getElementById('top-views-container');

        if (data && data.length > 0) {
          container.innerHTML = data.map((media, index) => `
          <div class="media-item group relative">
            <div class="absolute top-0 left-0 bg-red-600 text-white font-bold px-2 py-1 rounded-br-lg z-10 text-xs">
              TOP ${index + 1}
            </div>
            <a href="/watch?id=${media.id}" class="block overflow-hidden rounded-lg">
              <img src="${media.image_embed || '/images/placeholder.png'}" 
                   class="w-full h-40 object-cover transform group-hover:scale-105 transition duration-300" 
                   alt="${media.topic}">
            </a>
            <div class="content mt-2">
              <h3 class="text-white text-[13px] font-semibold line-clamp-1">${media.topic}</h3>
              <p class="text-gray-400 text-[10px]">${Number(media.views).toLocaleString()} views</p>
            </div>
          </div>
        `).join('');
        } else {
          container.innerHTML = '<p class="text-gray-500">ไม่มีข้อมูลหนังยอดนิยม</p>';
        }
      } catch (error) {
        console.error('Error fetching top views:', error);
        document.getElementById('top-views-container').innerHTML = '';
      }
    }

    // รันฟังก์ชันเมื่อโหลดหน้าเว็บเสร็จ
    document.addEventListener('DOMContentLoaded', fetchTopViews);
  </script>
</body>

</html>