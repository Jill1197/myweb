<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JAV789VK - ดูวิดีโอฟรี</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VLMJVZ7NQF"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-VLMJVZ7NQF');
  </script>
</head>
<body class="bg-gray-900 text-gray-300 font-sans">
  <div class="min-h-screen">
    <%- include('components/header') %>
    <%- include('components/sidebar') %>
    <main class="container mx-auto px-6 py-8">
      <%- include('components/advert', { numberOfAds: 10 }) %>
      <div class="flex flex-col lg:flex-row gap-8 mt-5">
        <div class="w-full lg:w-3/4">
          <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-cyan-400 pl-4">หนังยอดนิยม 🔥</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-4 gap-6">
            <% mediaList.forEach(media => { %>
              <div class="media-item">
                <a href="/watch?id=<%= media.id %>">
                  <img src="<%= media.image_embed %>" alt="media" class="w-full h-auto rounded-lg" />
                </a>
                <div class="mt-2 text-white text-sm font-semibold"><%= media.topic %></div>
              </div>
            <% }) %>
          </div>

          <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div class="flex justify-center items-center space-x-1 mt-6 overflow-x-auto text-sm">
              <% if (currentPage > 1) { %>
                <a href="/?page=1" class="px-3 py-1 bg-gray-700 text-white rounded hover:bg-cyan-500">««</a>
                <a href="/?page=<%= currentPage - 1 %>" class="px-3 py-1 bg-gray-700 text-white rounded hover:bg-cyan-500">«</a>
              <% } %>

              <% 
                const maxVisible = 3;
                let start = Math.max(1, currentPage - 1);
                let end = Math.min(totalPages, currentPage + 1);
                if (start > 2) { 
              %>
                <a href="/?page=1" class="px-3 py-1 bg-gray-700 text-gray-200 rounded">1</a>
                <span class="px-2">...</span>
              <% } %>

              <% for (let i = start; i <= end; i++) { %>
                <a href="/?page=<%= i %>" class="px-3 py-1 rounded <%= i === currentPage ? 'bg-cyan-500 text-white' : 'bg-gray-700 text-gray-200' %>"><%= i %></a>
              <% } %>

              <% if (end < totalPages) { %>
                <span class="px-2">...</span>
                <a href="/?page=<%= totalPages %>" class="px-3 py-1 bg-gray-700 text-gray-200 rounded"><%= totalPages %></a>
              <% } %>

              <% if (currentPage < totalPages) { %>
                <a href="/?page=<%= currentPage + 1 %>" class="px-3 py-1 bg-gray-700 text-white rounded">»</a>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
