  <script>
      // ฟังก์ชันสั่งเลื่อน
    function scrollSlider(direction) {
      const container = document.getElementById('top-views-container');
      const scrollAmount = 300; // ระยะการเลื่อน
      if (direction === 'left') {
        container.scrollLeft -= scrollAmount;
      } else {
        container.scrollLeft += scrollAmount;
      }
    }

    // อัปเดตฟังก์ชัน fetchTopViews ให้สร้างโครงสร้างแบบคอลัมน์แนวนอน
    async function fetchTopViews() {
      try {
        const response = await fetch('/api/v1/top-views/5');
        const data = await response.json();
        const container = document.getElementById('top-views-container');

        if (data && data.length > 0) {
          container.innerHTML = data.map((media, index) => `
            <div class="flex-shrink-0 w-[180px] sm:w-[200px] group relative">
              <div class="absolute top-0 left-0 bg-red-600 text-white font-bold px-2 py-1 rounded-br-lg z-10 text-xs">
                TOP ${index + 1}
              </div>
              <a href="/watch?id=${media.id}" class="block overflow-hidden rounded-lg">
                <img src="${media.image_embed || '/images/placeholder.png'}"
                    class="w-full h-40 object-cover transform group-hover:scale-105 transition duration-300"
                    alt="${media.topic}">
              </a>
              <div class="content mt-2">
                <h3 class="text-white text-[13px] font-semibold line-clamp-1">${media.topic}</h3>
                <p class="text-gray-400 text-[10px]">${Number(media.views).toLocaleString()} views</p>
              </div>
            </div>
          `).join('');
        } else {
          container.innerHTML = '<p class="text-gray-500 w-full text-center">ไม่มีข้อมูลหนังยอดนิยม</p>';
        }
      } catch (error) {
        console.error('Error fetching top views:', error);
      }
    }

    document.addEventListener('DOMContentLoaded', fetchTopViews);
  </script>
