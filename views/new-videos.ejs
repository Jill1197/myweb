<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Videos</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans">

    <%- include('components/header') %>

        <main class="container mx-auto px-6 py-8">
            <%- include('components/advert', { numberOfAds: 10 }) %>
                <br>
                <h1 class="text-3xl font-bold text-white mb-6">New Videos</h1>

                <% if (!videos || videos.length === 0) { %>
    <p class="text-gray-400">ไม่มีวิดีโอยอดนิยม</p>
<% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% videos.forEach(video => { %>
            <div class="bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-transform duration-200 ease-in-out hover:scale-105">
                <a href="/watch?id=<%= video.id %>" title="<%= video.topic %>">
                    
                    <%# --- ส่วนที่แก้ไข: กำหนด Aspect Ratio 16:9 --- %>
                    <%# ใช้ class 'aspect-video' เพื่อบังคับให้เป็นแนวนอน %>
                    <%# และ 'relative' เพื่อให้รูปภาพข้างในอ้างอิงขนาดได้ %>
                    <div class="aspect-video relative overflow-hidden bg-gray-700">
                        <img 
                            src="<%= video.image_embed %>" 
                            alt="<%= video.topic %>"
                            <%# --- ส่วนที่แก้ไข: จัดการรูปภาพข้างใน --- %>
                            <%# 'absolute inset-0' ให้รูปเต็มพื้นที่ %>
                            <%# 'object-cover' สำคัญมาก! เพื่อให้รูปขยายเต็มโดยไม่เบี้ยว (จะโดน Crop นิดหน่อยถ้าสัดส่วนไม่พอดี) %>
                            class="absolute inset-0 w-full h-full object-cover" 
                            loading="lazy"
                            <%# เรียกใช้ placeholder จาก path ที่ถูกต้อง (สมมติว่าคุณย้ายไป public แล้ว) %>
                            onerror="this.onerror=null; this.src='/images/placeholder.png';"
                        >
                    </div>
                    <%# ---------------------------------------- %>
                    
                </a>
                <div class="p-4">
                    <h2 class="text-white font-bold mb-2 text-lg truncate">
                        <%= video.topic %>
                    </h2>
                    <p class="text-gray-400 text-sm">Views: <%= video.views || 0 %></p>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>
<script>
                            // สั่ง Cache รูปภาพเบื้องหลัง (ไม่ขัดจังหวะการโหลดหน้าเว็บ)
                            window.addEventListener('DOMContentLoaded', () => {
                                document.querySelectorAll('.video-thumb').forEach(img => {
                                    // ยิง API ไปสั่งให้ Server ดาวน์โหลดรูปมาเก็บไว้ (ถ้ายังไม่มี)
                                    // โดยส่ง URL ต้นทางไปให้ Server จัดการ
                                    fetch(`/api/cache-image?url=${encodeURIComponent(img.src)}`)
                                        .catch(err => console.error('Cache background task failed'));
                                });
                            });
                        </script>
        </main>

</body>

</html>