<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Tags | Jav789VK</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans min-h-screen p-6">
  <!-- Popunder -->
  <script src="https://temptedrecognise.com/40/9e/d5/409ed51524bea4d5a17516963dca33ef.js"></script>
  <!-- Popunder -->

  <div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold border-l-4 border-cyan-400 pl-3 text-white">Tag Manager</h1>
      <a href="/manage" class="px-4 py-2 bg-gray-700 rounded hover:bg-gray-600 transition text-white">Back to Manager</a>
    </div>

    <div class="bg-gray-800 p-6 rounded-lg mb-8 shadow-lg border border-gray-700">
      <h2 class="text-sm font-semibold text-gray-400 mb-4 uppercase">Add New Tag</h2>
      <form method="POST" action="/tags" class="flex gap-2">
        <input type="text" name="name" placeholder="ชื่อแท็ก เช่น นักศึกษา, ชัดแจ๋ว" required
          class="flex-1 px-4 py-2 rounded bg-gray-900 border border-gray-600 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500" />
        <button type="submit" class="px-6 py-2 bg-cyan-600 text-white rounded hover:bg-cyan-500 transition font-bold">Add Tag</button>
      </form>
    </div>

    <div class="overflow-x-auto bg-gray-800 rounded-lg shadow-xl border border-gray-700">
      <table class="min-w-full">
        <thead class="bg-gray-700 text-gray-300">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Name & Edit</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-700">
          <% if (typeof tags !== 'undefined' && tags.length > 0) { %>
            <% tags.forEach(tag => { %>
              <tr class="hover:bg-gray-700/50 transition">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400"><%= tag.id %></td>
                <td class="px-6 py-4">
                  <form method="POST" action="/tags/edit/<%= tag.id %>" class="flex gap-2">
                    <input type="text" name="name" value="<%= tag.name %>"
                      class="px-2 py-1 text-sm rounded bg-gray-900 border border-gray-600 text-white focus:ring-1 focus:ring-yellow-500 outline-none" />
                    <button type="submit" class="text-xs px-3 py-1 bg-yellow-600/20 text-yellow-500 border border-yellow-600/50 rounded hover:bg-yellow-600 hover:text-white transition">Save</button>
                  </form>
                </td>
                <td class="px-6 py-4">
                  <a href="/tags/delete/<%= tag.id %>"
                     onclick="return confirm('คุณแน่ใจนะว่าจะลบแท็กนี้?')"
                     class="text-xs px-3 py-1 bg-red-600/20 text-red-500 border border-red-600/50 rounded hover:bg-red-600 hover:text-white transition">
                    Delete
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="3" class="px-6 py-10 text-center text-gray-500">ไม่พบข้อมูลแท็กในระบบ</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</body>
</html>