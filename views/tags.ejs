<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <link rel="icon" href="/favicon.png" type="image/png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title class="px-4 py-2 bg-cyan-600 rounded hover:bg-cyan-500 transition">Manage Tags</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VLMJVZ7NQF"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-VLMJVZ7NQF');
  </script>
</head>

<body class="bg-gray-900 text-gray-300 font-sans min-h-screen p-6">
  <h1 class="text-2xl font-bold mb-6 border-l-4 border-cyan-400 pl-3">Tag Manager</h1>

  <button class="px-4 mb-4 py-2 bg-cyan-600 rounded hover:bg-cyan-500 transition"><a href="/manage"
      class="text-white">Manager</a></button>
  <!-- Form add tag -->
  <form method="POST" action="/tags" class="mb-6 flex gap-2">
    <input type="text" name="name" placeholder="New tag"
      class="px-3 py-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500" />
    <button type="submit" class="px-4 py-2 bg-cyan-600 rounded hover:bg-cyan-500 transition">Add Tag</button>
  </form>

  <!-- List tags -->
  <table class="min-w-full bg-gray-800 rounded-lg shadow-lg overflow-hidden">
    <thead class="bg-gray-700 text-gray-200">
      <tr>
        <th class="px-6 py-3 text-left">ID</th>
        <th class="px-6 py-3 text-left">Name</th>
        <th class="px-6 py-3 text-left">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% tags.forEach(tag=> { %>
        <tr class="border-b border-gray-700 hover:bg-gray-700 transition">
          <td class="px-6 py-4">
            <%= tag.id %>
          </td>
          <td class="px-6 py-4">
            <form method="POST" action="/tags/edit/<%= tag.id %>" class="flex gap-2">
              <input type="text" name="name" value="<%= tag.name %>"
                class="px-2 py-1 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500" />
              <button type="submit" class="px-2 py-1 bg-yellow-500 rounded hover:bg-yellow-400 transition">Save</button>
            </form>
          </td>
          <td class="px-6 py-4">
            <a href="/tags/delete/<%= tag.id %>" onclick="return confirm('Confirm delete?')"
              class="px-2 py-1 bg-red-600 rounded hover:bg-red-500 transition">Delete</a>
          </td>
        </tr>
        <% }) %>
    </tbody>
  </table>

</body>

</html>